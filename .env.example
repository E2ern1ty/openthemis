# ─── 分析执行层：LLM 配置（可选，不配置时使用 Mock 分析）───
# 支持 OpenAI 兼容接口（DeepSeek / Qwen / Claude 等）
LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# ─── 采集层：独立进程地址 ───
# 分析执行层通过 HTTP 契约调用采集层。采集层是一个 OpenCLI 网关：
# 所有渠道（小红书 / 微博等）统一通过 opencli 接入，登录态复用用户 Chrome 会话。
# 采集层默认监听 4001 端口，可独立部署到其他机器。
COLLECTOR_URL=http://localhost:4001
# 可选：与采集层 COLLECTOR_TOKEN 一致时启用 Bearer 鉴权
# COLLECTOR_TOKEN=your-shared-secret
